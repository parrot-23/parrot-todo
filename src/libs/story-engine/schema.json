{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/story-skeleton.schema.json",
  "title": "叙事骨架包 Schema",
  "description": "互动叙事引擎的骨架包格式定义：节点 + 原子步骤 + 资源包 + 结局定义器",
  "type": "object",
  "required": ["meta", "nodes", "steps", "assets", "choices", "entry"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "version"],
      "properties": {
        "title": { "type": "string" },
        "version": { "type": "integer" }
      }
    },
    "nodes": {
      "type": "object",
      "description": "节点注册表：id → 节点（幕/章/场景）",
      "additionalProperties": {
        "type": "object",
        "required": ["id", "type", "title", "children"],
        "properties": {
          "id": { "type": "string" },
          "type": { "enum": ["act", "chapter", "scene"] },
          "title": { "type": "string" },
          "children": {
            "type": "array",
            "items": { "type": "string" },
            "description": "子节点 id 列表（幕→章，章→场景；场景内是步骤 id 列表）"
          }
        }
      }
    },
    "steps": {
      "type": "object",
      "description": "步骤注册表：id → 原子步骤",
      "additionalProperties": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "enum": ["bg", "sprite", "bgm", "sfx", "dialog", "narration", "effect", "flag", "task", "branch"]
          }
        }
      }
    },
    "assets": {
      "type": "object",
      "description": "资源包：id → 资源",
      "additionalProperties": {
        "type": "object",
        "required": ["id", "kind", "path"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["image", "audio", "video", "sprite", "font"] },
          "path": { "type": "string" }
        }
      }
    },
    "choices": {
      "type": "object",
      "description": "结局定义器：场景 id → 选项列表",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["text", "goto"],
          "properties": {
            "text": { "type": "string" },
            "goto": { "type": "string" },
            "require": { "type": "string" },
            "setFlags": { "type": "object" },
            "retry": { "type": "boolean" }
          }
        }
      }
    },
    "entry": { "type": "string", "description": "入口场景 id" }
  }
}
